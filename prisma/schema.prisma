generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum DeviceStatus {
  pending
  online
  idle
  offline
  blocked
}

enum PaymentMethod {
  MPESA
  AIRTEL_MONEY
  AIRTIME
  OTHER
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  WAITING
  SKIPPED
  CANCELLED
}

enum VerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  FAILED
}

enum CommandStatus {
  QUEUED
  DELIVERED
  ACKNOWLEDGED
  EXECUTING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
  MAINTENANCE
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

enum ProductType {
  DEVICE
  SUBSCRIPTION
  TOKEN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PaymentStatus {
  CREATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TokenDeliveryStatus {
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  QUEUED
  DELIVERED
  FAILED
  CANCELLED
}

enum AuditActorType {
  CUSTOMER
  ADMIN
  DEVICE
  SYSTEM
}

model User {
  id           Int      @id @default(autoincrement())
  openId       String   @unique @db.VarChar(64)
  name         String?
  email        String?  @db.VarChar(320)
  loginMethod  String?  @db.VarChar(64)
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSignedIn DateTime @default(now())

  requestedCommands Command[] @relation("RequestedCommands")
  createdProducts   Product[] @relation("CreatedProducts")
  auditLogs         AuditLog[] @relation("AdminAuditLogs")

  adminCredential AdminCredential?
  adminSessions   AdminSession[]

  @@map("users")
}

model AdminCredential {
  id           String   @id @default(cuid())
  userId       Int      @unique
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

model AdminSession {
  id         String   @id @default(cuid())
  userId     Int
  tokenHash  String   @unique @db.VarChar(128)
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("admin_sessions")
}

model Customer {
  id                String         @id @default(cuid())
  email             String         @unique @db.VarChar(320)
  passwordHash      String         @db.VarChar(255)
  name              String         @db.VarChar(180)
  phone             String?        @db.VarChar(40)
  status            CustomerStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  lastSignedInAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sessions          CustomerSession[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  pairingTokens     PairingToken[]
  devices           Device[]
  subscriptions     Subscription[]
  payments          BingwaPayment[]
  entitlements      EntitlementGrant[]
  tokenPurchases    TokenPurchase[]
  auditLogs         AuditLog[] @relation("CustomerAuditLogs")

  @@index([status, createdAt])
  @@map("customers")
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique @db.VarChar(128)
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("customer_sessions")
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  customerId String
  tokenHash  String   @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt, consumedAt])
  @@map("password_reset_tokens")
}

model Device {
  id                    Int          @id @default(autoincrement())
  deviceId              String       @unique @db.VarChar(128)
  deviceName            String       @db.VarChar(160)
  model                 String?      @db.VarChar(160)
  manufacturer          String?      @db.VarChar(120)
  androidVersion        String?      @db.VarChar(40)
  sdkVersion            String?      @db.VarChar(40)
  appVersion            String?      @db.VarChar(80)
  appBuild              String?      @db.VarChar(40)
  phoneNumber           String?      @db.VarChar(40)
  simSlot               Int?
  subscriptionId        Int?
  carrierName           String?      @db.VarChar(120)
  iccId                 String?      @db.VarChar(160)
  automationSimConfigured Boolean     @default(false)
  batteryPercent        Int?
  airtimeBalance        Decimal?     @db.Decimal(12, 2)
  tokenBalance          Int?
  commissionTotal       Decimal?     @db.Decimal(12, 2)
  completedToday        Int?
  pendingCount          Int?
  scheduledCount        Int?
  failedCount            Int?
  successRate           Decimal?     @db.Decimal(5, 2)
  automationEnabled     Boolean?
  executionState        String?      @db.VarChar(40)
  latencyMs             Int?
  status                DeviceStatus @default(pending)
  lastHeartbeatAt       DateTime?
  lastSyncAt            DateTime?
  enrollmentTokenHash   String?      @db.VarChar(128)
  enrolledAt            DateTime?
  customerId            String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  commands       Command[]
  subscriptions  Subscription[]
  syncEvents     SyncEvent[]
  credentials    DeviceCredential[]
  pairingTokens  PairingToken[]
  dataPlans      DeviceDataPlan[]
  payments       BingwaPayment[]
  entitlements   EntitlementGrant[]
  tokenPurchases TokenPurchase[]
  auditLogs      AuditLog[]

  @@index([deviceId, enrollmentTokenHash], map: "devices_enrollment_lookup_idx")
  @@index([status, lastHeartbeatAt], map: "devices_heartbeat_idx")
  @@index([customerId, status], map: "devices_customer_status_idx")
  @@map("devices")
}

model DeviceCredential {
  id         String   @id @default(cuid())
  deviceId   Int
  tokenHash  String   @unique @db.VarChar(128)
  createdAt  DateTime @default(now())
  rotatedAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
  @@map("device_credentials")
}

model PairingToken {
  id          String   @id @default(cuid())
  customerId  String
  deviceId    Int?
  codeHash    String   @db.VarChar(128)
  secretHash  String   @unique @db.VarChar(128)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([customerId, expiresAt, consumedAt])
  @@index([codeHash, expiresAt])
  @@map("pairing_tokens")
}

model Transaction {
  id                  Int                @id @default(autoincrement())
  deviceId            Int?
  androidTransactionId String?            @db.VarChar(128)
  projectionKey       String?            @unique(map: "transactions_projection_key_unique") @db.VarChar(220)
  executionId         String?            @db.VarChar(128)
  operationId         String?            @db.VarChar(160)
  customerName        String?            @db.VarChar(180)
  phoneNumber         String             @db.VarChar(40)
  packageName         String             @db.VarChar(160)
  amount              Decimal            @db.Decimal(12, 2)
  paymentMethod       PaymentMethod?
  status              TransactionStatus  @default(PENDING)
  verificationStatus  VerificationStatus?
  verificationMessage String?
  receiptCode         String?            @db.VarChar(120)
  issue               String?
  executedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([phoneNumber, status, createdAt], map: "transactions_search_idx")
  @@index([deviceId, createdAt], map: "transactions_device_idx")
  @@index([executionId])
  @@map("transactions")
}

model Command {
  id            Int          @id @default(autoincrement())
  deviceId      Int
  commandType   String       @db.VarChar(80)
  payload       Json?
  status        CommandStatus @default(QUEUED)
  requestedBy   Int?
  requestedAt   DateTime     @default(now())
  deliveredAt   DateTime?
  acknowledgedAt DateTime?
  executedAt    DateTime?
  resultMessage String?
  expiresAt     DateTime?

  device      Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requestedByUser User? @relation("RequestedCommands", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([deviceId, status, requestedAt], map: "commands_poll_idx")
  @@index([deviceId, id, status], map: "commands_result_idx")
  @@map("commands")
}

model Subscription {
  id            Int                @id @default(autoincrement())
  customerId    String?
  deviceId      Int?
  productId     String?
  storeName     String             @db.VarChar(180)
  ownerPhone    String?            @db.VarChar(40)
  planName      String             @db.VarChar(120)
  status        SubscriptionStatus @default(TRIAL)
  tokenBalance  Int                @default(0)
  renewalAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  entitlements EntitlementGrant[]

  @@index([deviceId, status], map: "subscriptions_device_idx")
  @@index([customerId, status])
  @@map("subscriptions")
}

model DeviceDataPlan {
  id                 Int      @id @default(autoincrement())
  deviceId           Int
  packageName        String   @db.VarChar(160)
  description        String?
  ussdCode           String?  @db.VarChar(160)
  price              Decimal? @db.Decimal(12, 2)
  validity           String?  @db.VarChar(80)
  dataAmount         String?  @db.VarChar(80)
  category           String?  @db.VarChar(100)
  isActive           Boolean  @default(true)
  commissionPerSale  Decimal? @db.Decimal(12, 2)
  executeSim         Int?
  ussdMode           String?  @db.VarChar(40)
  ussdSteps          String?
  source             String?  @db.VarChar(40)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, packageName])
  @@index([deviceId, isActive])
  @@map("device_data_plans")
}

model Service {
  id            Int           @id @default(autoincrement())
  serviceKey    String        @unique @db.VarChar(100)
  serviceName   String        @db.VarChar(160)
  description   String?
  status        ServiceStatus @default(OPERATIONAL)
  lastCheckedAt DateTime?
  updatedAt     DateTime      @updatedAt

  @@map("services")
}

model SyncEvent {
  id              Int      @id @default(autoincrement())
  deviceId        Int
  eventType       String   @db.VarChar(80)
  payload         Json?
  receivedAt      DateTime @default(now())
  accepted        Boolean  @default(true)
  rejectionReason String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, receivedAt], map: "sync_events_device_idx")
  @@map("sync_events")
}

model Product {
  id                String        @id @default(cuid())
  productType       ProductType
  name              String        @db.VarChar(160)
  slug              String        @unique @db.VarChar(180)
  description       String?
  price             Decimal?      @db.Decimal(12, 2)
  currency          String        @default("KES") @db.VarChar(3)
  durationDays      Int?
  deviceLimit       Int?
  tokenQuantity     Int?
  status            ProductStatus @default(DRAFT)
  createdBy         Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  creator      User?             @relation("CreatedProducts", fields: [createdBy], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  payments     BingwaPayment[]
  entitlements   EntitlementGrant[]
  tokenPurchases TokenPurchase[]

  @@index([productType, status])
  @@map("products")
}

model BingwaPayment {
  id                    String        @id @default(cuid())
  customerId            String
  productId             String
  deviceId              Int?
  idempotencyKey        String        @unique @db.VarChar(180)
  phone                 String        @db.VarChar(40)
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("KES") @db.VarChar(3)
  status                PaymentStatus @default(CREATED)
  checkoutRequestId     String?       @unique @db.VarChar(180)
  merchantRequestId     String?       @db.VarChar(180)
  payflowTransactionId  String?       @db.VarChar(180)
  receiptCode           String?       @db.VarChar(120)
  failureCode           String?       @db.VarChar(80)
  failureMessage        String?
  statusCheckedAt       DateTime?
  completedAt           DateTime?
  activatedAt           DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  device      Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  entitlement  EntitlementGrant?
  tokenPurchase TokenPurchase?
  auditLogs    AuditLog[]

  @@index([customerId, status, createdAt])
  @@index([checkoutRequestId, status])
  @@map("bingwa_payments")
}

model TokenPurchase {
  id              String            @id @default(cuid())
  customerId      String
  deviceId        Int
  productId       String
  paymentId       String?           @unique
  commandId       Int?              @unique
  idempotencyKey   String            @unique @db.VarChar(180)
  phone           String            @db.VarChar(40)
  tokens          Int
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("KES") @db.VarChar(3)
  purchaseMethod  PaymentMethod
  deliveryStatus  TokenDeliveryStatus @default(PAYMENT_PENDING)
  failureMessage  String?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  payment  BingwaPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([customerId, deliveryStatus, createdAt])
  @@index([deviceId, deliveryStatus, createdAt])
  @@map("token_purchases")
}

model EntitlementGrant {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  customerId    String
  productId     String
  deviceId      Int?
  subscriptionId Int?
  activatedAt   DateTime @default(now())
  expiresAt     DateTime?

  payment      BingwaPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  device       Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([customerId, expiresAt])
  @@map("entitlement_grants")
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorUserId Int?
  actorCustomerId String?
  deviceId   Int?
  paymentId  String?
  action     String         @db.VarChar(120)
  metadata   Json?
  createdAt  DateTime       @default(now())

  actorUser     User?         @relation("AdminAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorCustomer Customer?     @relation("CustomerAuditLogs", fields: [actorCustomerId], references: [id], onDelete: SetNull)
  device        Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  payment       BingwaPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([actorCustomerId, createdAt])
  @@index([paymentId, createdAt])
  @@map("audit_logs")
}
